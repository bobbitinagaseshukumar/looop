{
  "name": "looop-workspace",
  "version": "1.0.0",
  "description": "Looop - Share. Reuse. Connect. Community Unused Items Sharing Platform (MERN)",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix server install",
    "postinstall": "npm --prefix server install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "start:client": "npm --prefix client start",
    "build:client": "npm --prefix client run build",
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run start:client\""
  },
  "keywords": [
    "looop",
    "mern",
    "mongodb",
    "express",
    "react",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "pg": "^8.23.1"
  }
}
